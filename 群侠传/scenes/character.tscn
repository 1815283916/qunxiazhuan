offset_right = 1270.0
offset_bottom = 620.0
theme_override_colors/font_color = Color(0.22, 0.17, 0.13, 1)
theme_override_font_sizes/font_size = 24
text = "宇文逸，武当门下年轻侠客。\n\n自幼随师修习剑术，性情沉静而重信义。初入江湖便卷入华山论剑的纷争，立誓以手中之剑扶危济困。\n\n称号：初入江湖\n关系：武当派 · 冲虚道长"
