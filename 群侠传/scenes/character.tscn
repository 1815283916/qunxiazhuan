theme_override_font_sizes/font_size = 23
text = "武学常识  120 / 460        天赋总数  4\n\n异世人 【消耗武学常识：0】\n来自另一个世界的神秘人，具有深不见底的潜力。\n\n洞察 【消耗武学常识：20】\n攻击时更容易发现敌人的破绽。\n\n不老长春 【消耗武学常识：60】\n气血低于一半时提升防御。"
autowrap_mode = 2

[node name="BiographyPanel" type="Label" parent="Paper"]
